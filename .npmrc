# Skip install scripts.
# @prisma/engines downloads native binaries in a postinstall hook, which fails
# with ECONNRESET on networks where binaries.prisma.sh is blocked (Iran / Pars Pack).
# We do not need it:
#   - the generated client is committed to src/generated/prisma
#   - Prisma 7 runs through @prisma/adapter-pg (plain `pg`), not a Rust engine
ignore-scripts=true
