name: Video call reminders

# Free replacement for Netlify scheduled functions. The endpoint is idempotent
# (videoLinkSentAt) and looks 15 minutes ahead, so a 5-minute tick is enough.
on:
  schedule:
    - cron: "*/5 * * * *"
  workflow_dispatch: {}

concurrency:
  group: video-calls
  cancel-in-progress: false

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger reminder endpoint
        run: |
          curl --fail-with-body --silent --show-error \
            --max-time 60 --retry 2 --retry-delay 5 \
            "${{ secrets.PARTO_BASE_URL }}/api/cron/video-calls?secret=${{ secrets.CRON_SECRET }}"
