# Database (PostgreSQL recommended for production; use docker-compose for local dev)
DATABASE_URL="postgresql://parto:parto@localhost:5432/parto?schema=public"

# Auth
JWT_SECRET="change-me-in-production-use-a-strong-random-string-at-least-32-chars"
ADMIN_PASSWORD="admin123"

# Runtime
NODE_ENV="production"

# Optional: persistent directory for uploaded files (default: ./public/uploads)
# UPLOAD_DIR="/var/data/uploads"
