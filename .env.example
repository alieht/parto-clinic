# Database (PostgreSQL) — used by docker-compose
DB_PASSWORD="change-me-strong-db-password"

# Database URL (for local dev / Supabase)
DATABASE_URL="postgresql://parto:change-me-strong-db-password@localhost:5432/parto?schema=public"

# Auth
JWT_SECRET="change-me-use-a-strong-random-string-at-least-32-chars"
ADMIN_EMAIL="admin@parto.online"
ADMIN_PASSWORD="change-me-strong-admin-password"
SECRETARY_EMAIL="secretary@parto.online"
SECRETARY_PASSWORD="change-me-strong-secretary-password"

# One-time setup token (for /api/setup endpoint; remove after use)
SETUP_TOKEN="change-me-random-secret"

# Runtime
NODE_ENV="production"

# Optional: persistent directory for uploaded files (default: ./public/uploads)
# UPLOAD_DIR="/var/data/uploads"

# SMS.ir API key (from https://sms.ir panel)
SMSIR_API_KEY="your-sms-ir-api-key"

# Cron secret for video call notification endpoint
CRON_SECRET="change-me-random-cron-secret"

# Doctor's phone number for video call notifications
DOCTOR_PHONE="09991561688"

# Mobile numbers for admin-panel password recovery (SMS.ir template 583457)
ADMIN_PHONE="09123456789"
SECRETARY_PHONE="09123456789"

# Video visits
# Secret used to HMAC-sign the room link. Falls back to JWT_SECRET when unset.
# VIDEO_LINK_SECRET="change-me-random-video-secret"
# Base URL of the Jitsi deployment (default: https://meet.jit.si)
# JITSI_BASE_URL="https://meet.jit.si"
# Tehran offset in minutes for appointment wall-clock (Iran has no DST)
# CLINIC_TZ_OFFSET_MINUTES="210"

# Long-lived hosts (Pars Pack, Liara, Docker, VPS): run the video-reminder job
# inside the app instead of an external cron. Leave unset on Netlify/serverless.
# INPROCESS_CRON="1"
# INPROCESS_CRON_INTERVAL_MS="60000"

# Minutes before the appointment to SMS the room link (default 15)
# VIDEO_LEAD_MINUTES="15"
